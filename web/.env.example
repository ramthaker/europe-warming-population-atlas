# Public, browser-visible Amazon Location key. Restrict it to your site referrer and map actions.
VITE_LOCATION_API_KEY=
VITE_AWS_REGION=eu-central-1
VITE_LOCATION_MAP_NAME=europe-climate-explorer-map
# Optional; defaults to /data/climate-cells.pmtiles
VITE_DATA_URL=
# Local Strands API. Set the deployed HTTPS endpoint after hosting the agent service.
VITE_AGENT_API_URL=http://127.0.0.1:8000
